{
  "name": "quality-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file=.env.local --import tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "start": "vite preview",
    "test": "npm run test:unit && npm run build",
    "test:unit": "node --import tsx --test 'server/**/*.test.ts'",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint build worker server shared vite.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jsonrepair": "^3.15.0",
    "playwright": "^1.62.1",
    "vue": "3.5.22",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "6.0.8",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "vue-tsc": "^3.3.9",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
